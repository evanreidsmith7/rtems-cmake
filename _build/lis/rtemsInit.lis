  96:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * @brief State of a processor.
  97:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *
  98:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * The processor state controls the life cycle of processors at the lowest
  99:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * level.  No multi-threading or other high-level concepts matter here.
 100:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *
 101:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * State changes must be initiated via _Per_CPU_State_change().  This function
 102:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * may not return in case someone requested a shutdown.  The
 103:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * _SMP_Send_message() function will be used to notify other processors about
 104:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * state changes if the other processor is in the up state.
 105:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *
 106:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * Due to the sequential nature of the basic system initialization one
 107:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * processor has a special role.  It is the processor executing the boot_card()
 108:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * function.  This processor is called the boot processor.  All other
 109:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * processors are called secondary.
 110:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *
 111:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * @dot
 112:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * digraph states {
 113:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   i [label="PER_CPU_STATE_INITIAL"];
 114:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   rdy [label="PER_CPU_STATE_READY_TO_START_MULTITASKING"];
 115:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   reqsm [label="PER_CPU_STATE_REQUEST_START_MULTITASKING"];
 116:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   u [label="PER_CPU_STATE_UP"];
 117:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   s [label="PER_CPU_STATE_SHUTDOWN"];
 118:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   i -> rdy [label="processor\ncompleted initialization"];
 119:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   rdy -> reqsm [label="boot processor\ncompleted initialization"];
 120:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   reqsm -> u [label="processor\nstarts multitasking"];
 121:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   i -> s;
 122:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   rdy -> s;
 123:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   reqsm -> s;
 124:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  *   u -> s;
 125:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * }
 126:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  * @enddot
 127:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****  */
 128:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h **** typedef enum {
 129:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   /**
 130:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * @brief The per CPU controls are initialized to zero.
 131:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    *
 132:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * The boot processor executes the sequential boot code in this state.  The
 133:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * secondary processors should perform their basic initialization now and
 134:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * change into the PER_CPU_STATE_READY_TO_START_MULTITASKING state once this
 135:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * is complete.
 136:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    */
 137:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   PER_CPU_STATE_INITIAL,
 138:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h **** 
 139:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   /**
 140:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * @brief Processor is ready to start multitasking.
SPARC GAS   			page 6


 141:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    *
 142:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * The secondary processor performed its basic initialization and is ready to
 143:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * receive inter-processor interrupts.  Interrupt delivery must be disabled
 144:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * in this state, but requested inter-processor interrupts must be recorded
 145:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * and must be delivered once the secondary processor enables interrupts for
 146:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * the first time.  The boot processor will wait for all secondary processors
 147:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * to change into this state.  In case a secondary processor does not reach
 148:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * this state the system will not start.  The secondary processors wait now
 149:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * for a change into the PER_CPU_STATE_REQUEST_START_MULTITASKING state set
 150:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * by the boot processor once all secondary processors reached the
 151:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * PER_CPU_STATE_READY_TO_START_MULTITASKING state.
 152:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    */
 153:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   PER_CPU_STATE_READY_TO_START_MULTITASKING,
 154:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h **** 
 155:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   /**
 156:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * @brief Multitasking start of processor is requested.
 157:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    *
 158:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * The boot processor completed system initialization and is about to perform
 159:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * a context switch to its heir thread.  Secondary processors should now
 160:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * issue a context switch to the heir thread.  This normally enables
 161:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    * interrupts on the processor for the first time.
 162:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****    */
 163:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h ****   PER_CPU_STATE_REQUEST_START_MULTITASKING,
 164:/opt/rcc-1.3.2/sparc-gaisler-rtems5/gr712rc/lib/include/rtems/score/percpu.h **** 
